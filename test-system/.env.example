# 数字人测试系统配置模板：复制为 .env 并填写。

# Matrix homeserver（数字人真实运行的服务器）
HOMESERVER=https://im-ipm.ict.cmcc

# 被测数字人账号（dsh-matrix-agent 的分身）
TWIN_USER_ID=@ai-niukunliang:im-ipm.ict.cmcc

# 数字人账号 access token（用于「以数字人身份注入消息」；留空则禁用该功能，UI 会提示）
TWIN_ACCESS_TOKEN=

# 同事测试账号：格式 userId:accessToken，多个用逗号分隔（管理员在 homeserver 预建）
# 例：@zhangsan:im-ipm.ict.cmcc:syt_xxx,@lisi:im-ipm.ict.cmcc:syt_yyy
COLLEAGUE_TOKENS=

# AI 同事 LLM（OpenAI 兼容 API，独立 key，与 dsh 解耦）
# 示例（本地 codebuddy 代理）：
LLM_BASE_URL=http://127.0.0.1:8787/v1
LLM_API_KEY=sk-123456
LLM_MODEL=deepseek-v4-flash

# Web UI
WEB_HOST=127.0.0.1
WEB_PORT=3088

# 场景控制
ROUNDS_PER_ROOM=6        # 每个房间的对话轮次上限
REPLY_TIMEOUT_SECS=90    # 等数字人回复的超时秒数
ROOM_PREFIX=twin-test    # 测试房间名前缀
